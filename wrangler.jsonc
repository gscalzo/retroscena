{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "retroscena",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  // Persist Workers Logs for every request.
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // The built site is served as static assets; only /api/* reaches the
  // Worker. The hostnames are gated by Cloudflare Access (ADR-0005), so
  // assets are protected at the edge and the Worker re-verifies the Access
  // JWT on every API call — an email for the owner, a service token for agents.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // Migrations: npm run db:migrate:remote (CI applies them before each deploy).
  // Created once with: npx wrangler d1 create retroscena — the id is pasted here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "retroscena",
      "database_id": "801fa46e-493a-464b-9a46-f2115d491318",
      "migrations_dir": "migrations",
    },
  ],
  // The only public hostnames (ADR-0009). workers.dev and preview URLs are
  // disabled so the site is reachable solely through the Access-protected
  // custom domains; both are listed on the Access application.
  "routes": [
    { "pattern": "retroscena.effectivecode.co.uk", "custom_domain": true },
    { "pattern": "retroscena.gioscalzo.com", "custom_domain": true },
  ],
  "workers_dev": false,
  "preview_urls": false,
  // Cloudflare Access application "retroscena" (Zero Trust > Access > Applications).
  // The Worker verifies every Cf-Access-Jwt-Assertion against these; when
  // both are empty (local dev, where there is no Access edge) verification is
  // skipped — see worker/access.ts.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "plain-glitter-718b",
    "ACCESS_AUD": "ACCESS_AUD",
  },
}
